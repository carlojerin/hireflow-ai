# HireFlow AI configuration. Copy this file to .env and fill in the blanks.
# Never commit the real .env: it holds API keys and passwords.

# ---- AI providers --------------------------------------------------------------------------------------------------------------------
# Google Gemini: the live spoken interview, vision marking (design page, face check) and fallbacks.
GEMINI_API_KEY=
# Groq: the interview question brain, answer analysis, written-task marking and the assessment planner.
GROQ_API_KEY=

# ---- URLs ----------------------------------------------------------------------------------------------------------------------------
# Must be 127.0.0.1, not localhost: session cookies and every frontend API base URL use 127.0.0.1, and the cookie is SameSite=Lax
# ("localhost" and "127.0.0.1" count as different sites).
FRONTEND_BASE_URL=http://127.0.0.1:5500

# ---- Email (invites, reminders, offer letters, HR email verification) -----------------------------------------------------------------
# Primary sender: SMTP. For Gmail use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HireFlow AI
SMTP_USE_TLS=true

# Optional Gmail API (OAuth). Leave GOOGLE_REFRESH_TOKEN empty to use SMTP only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# ---- Live interview ------------------------------------------------------------------------------------------------------------------
# LiveKit carries the audio between the browser and the interviewer.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional video avatar (Tavus). Leave empty for audio only.
TAVUS_API_KEY=
JOBPILOT_AI_INTERVIEWER_AVATAR_ID=

INTERVIEW_REALTIME_PROVIDER=realtime
AI_REALTIME_MODEL=gemini-3.1-flash-live-preview
AI_REALTIME_VOICE=Kore

AI_INTERVIEW_PROVIDER=groq
AI_INTERVIEW_MODEL=openai/gpt-oss-120b
AI_INTERVIEW_EVALUATOR_PROVIDER=groq
AI_INTERVIEW_VISUAL_MODE=image

# Speech-to-text and text-to-speech for the turn-by-turn fallback pipeline only (the live interview speaks with Gemini Live).
AI_STT_PROVIDER=local
AI_STT_MODEL=base
AI_STT_GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite
AI_TTS_PROVIDER=gemini
AI_TTS_GEMINI_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
AI_TTS_VOICE=bf_emma

# ---- Assessments ---------------------------------------------------------------------------------------------------------------------
# Integrity violations that end an assessment. Keep 3 for real use; raise it only for demos.
ASSESSMENT_MAX_VIOLATIONS=3

# Coding test: candidate code runs in Docker (see backend/app/services/assessment/docker_sandbox_runner.py). Docker Desktop must be running.
# Optional Judge0 endpoint, only if you prefer a hosted runner:
JUDGE0_API_URL=
