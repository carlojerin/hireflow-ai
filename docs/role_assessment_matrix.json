{
  "stage_catalogue": {
    "stage1": "S1-INTRO",
    "stage4": "S4-AI-INT",
    "stage2": {
      "AP-CORE": {
        "name": "Aptitude - Core",
        "desc": "Quantitative + logical reasoning + verbal, 25-30 Q, 30 min. For roles that need analytical/engineering thinking."
      },
      "AP-LOGIC": {
        "name": "Aptitude - Logic/Verbal",
        "desc": "Logical + verbal + pattern reasoning, 20 Q, 20 min, light maths. For support/ops-leaning tech roles."
      },
      "AP-NUM": {
        "name": "Aptitude - Numerical/Data",
        "desc": "Number series, percentages, ratios, chart/table interpretation, 20-25 Q, 25 min. For finance/data-heavy roles."
      },
      "SJT": {
        "name": "Situational Judgement Test",
        "desc": "10-15 workplace scenarios, pick best/worst action, 20 min. For people-facing/non-technical roles where aptitude math adds little."
      }
    },
    "stage3": {
      "PRG": {
        "name": "Programming Test",
        "desc": "2-3 coding problems (easy/medium) in an online IDE with test cases, 60-90 min. Language chosen by role."
      },
      "PRG-L": {
        "name": "Light Programming / SQL / Scripting",
        "desc": "1-2 tasks: SQL queries, Python/Bash script, or config-as-code, 45 min."
      },
      "TECH-LAB": {
        "name": "Hands-on Technical Scenario",
        "desc": "Domain MCQ (15) + troubleshooting/lab scenario (log reading, config fix, architecture or incident question), 45-60 min. No heavy coding."
      },
      "TEST-DESIGN": {
        "name": "Test Design Task",
        "desc": "Given a feature/spec: write test cases, find seeded bugs, file a bug report, 45 min."
      },
      "WS-WRITE": {
        "name": "Written Work Sample",
        "desc": "Job-realistic writing task (email, brief, post, policy note, report) graded by rubric + AI, 30-45 min."
      },
      "WS-DATA": {
        "name": "Data/Spreadsheet Work Sample",
        "desc": "Provided messy dataset: clean, calculate, summarise findings (Excel/Sheets-style), 45 min."
      },
      "WS-DESIGN": {
        "name": "Design Task",
        "desc": "Short design brief: wireframe/critique/flow or portfolio case review, 60 min or take-home 24-48 h."
      },
      "WS-ROLE": {
        "name": "Role-play Simulation",
        "desc": "Simulated chat/email/call with a customer or prospect (AI persona), scored on empathy, accuracy, process, 15-20 min."
      },
      "CASE": {
        "name": "Case Study / Prioritisation",
        "desc": "Business case: prioritise, plan, estimate, recommend, 45 min written + short defence in interview."
      }
    }
  },
